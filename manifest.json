{
  "manifest_version": 3,
  "name": "TwReplyExport Pro — Intelligent X Thread & Reply Saver",
  "version": "2.0.0",
  "description": "Save complete X/Twitter threads and replies with embedded images, smart organization, and AI-ready summaries to DOCX, Markdown, HTML, JSON, CSV, or Excel.",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage"],
  "host_permissions": [
    "*://x.com/*",
    "*://twitter.com/*",
    "*://pbs.twimg.com/*",
    "*://abs.twimg.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
